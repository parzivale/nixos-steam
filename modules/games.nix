# Per-game (app) configuration: compatibility tool mapping and the properties from a game's Properties dialog.
{
  config,
  lib,
  ...
}:

let
  inherit (lib) types mkOption mkIf;
  cfg = config.programs.steam.client;

  # generated by tools/gen-options.py from the per-app storage research (see doc/)
  propsFile = ../data/app-properties.json;
  props = lib.filter (p: p.settable) (
    if builtins.pathExists propsFile then builtins.fromJSON (builtins.readFile propsFile) else [ ]
  );

  storeOf =
    appid: file:
    {
      localconfig = "local";
      sharedconfig = "roaming";
      config = "install";
      registry = "registry";
      appmanifest = "appmanifest:${appid}";
    }
    .${file};

  confidence = c: lib.optionalString (c != "" && c != "high") " *(${c} confidence)*";

  propType =
    p:
    if p.type == "bool" then
      types.bool
    else if p.type == "int" then
      types.int
    else if p.type == "enum" then
      types.enum (builtins.attrNames p.values)
    else
      types.str;

  propValue =
    p: v:
    if p.type == "bool" then
      (if v then builtins.elemAt p.boolEncoding 0 else builtins.elemAt p.boolEncoding 1)
    else if p.type == "enum" then
      p.values.${v}
    else
      toString v;

  propOptions = lib.listToAttrs (
    map (
      p:
      lib.nameValuePair p.option (mkOption {
        type = types.nullOr (propType p);
        default = null;
        description = lib.concatStringsSep "\n\n" (
          lib.filter (s: s != "") [
            (p.what + confidence p.confidence)
            (lib.optionalString (p.type == "enum")
              "Values: ${
                lib.concatStringsSep ", " (lib.mapAttrsToList (n: v: "`${n}` (stored as `${v}`)") p.values)
              }."
            )
            "Stored in `${p.file}` at `${p.path}`${
              lib.optionalString (p.file == "appmanifest") " (only while the game is installed)"
            }."
          ]
        );
      })
    ) props
  );

  # suffixes Steam uses in userdata/<id>/config/grid for each artwork type
  artworkSuffix = {
    grid = "p"; # vertical library capsule
    wide = ""; # horizontal capsule
    hero = "_hero";
    logo = "_logo";
    icon = "_icon";
  };

  compatEntries =
    appid: name: cfgStr: priority:
    let
      base = "Software\\Valve\\Steam\\CompatToolMapping\\${appid}";
    in
    [
      {
        store = "install";
        key = "${base}\\name";
        value = name;
      }
      {
        store = "install";
        key = "${base}\\config";
        value = cfgStr;
      }
      {
        store = "install";
        key = "${base}\\priority";
        value = toString priority;
      }
    ];
in
{
  options.programs.steam.client = {
    defaultCompatTool = mkOption {
      type = types.nullOr types.str;
      default = null;
      example = "proton_experimental";
      description = ''
        Compatibility tool used for all Windows games, as in Settings > Compatibility > "Run other titles with".
        Use the tool's internal name: `proton_experimental`, `proton_9`, `steamlinuxruntime_sniper`, or the
        directory name of a tool from {option}`programs.steam.extraCompatPackages` (e.g. `GE-Proton9-20`).
        Stored in `config.vdf` at `CompatToolMapping/0` (priority 75).
      '';
    };

    games = mkOption {
      type = types.attrsOf (
        types.submodule {
          options = propOptions // {
            compatTool = mkOption {
              type = types.nullOr types.str;
              default = null;
              example = "proton_experimental";
              description = ''
                Force a specific compatibility tool for this game (Properties > Compatibility). Same names as
                {option}`programs.steam.client.defaultCompatTool`. Stored in `config.vdf` at
                `CompatToolMapping/<appid>` (priority 250, as when chosen in the UI).
              '';
            };
            artwork = lib.genAttrs (builtins.attrNames artworkSuffix) (
              kind:
              mkOption {
                type = types.nullOr types.path;
                default = null;
                description = ''
                  Custom ${kind} image for this game, copied to `userdata/<id>/config/grid/<appid>${artworkSuffix.${kind}}.<ext>`
                  (the file Steam uses for "Set Custom Artwork"). PNG or JPEG; the extension of the source is kept.
                '';
              }
            );
            compatToolConfig = mkOption {
              type = types.str;
              default = "";
              description = "Extra tool configuration string stored next to {option}`compatTool` (usually empty).";
            };
          };
        }
      );
    };
  };

  config = mkIf cfg.enable {
    programs.steam.client.internal.userFiles = lib.mkMerge (
      lib.mapAttrsToList (
        appid: g:
        lib.mapAttrs' (
          kind: src:
          lib.nameValuePair "config/grid/${appid}${artworkSuffix.${kind}}${
            let
              m = builtins.match ".*(\\.[A-Za-z0-9]+)$" (toString src);
            in
            if m == null then ".png" else builtins.head m
          }" "${src}"
        ) (lib.filterAttrs (_: v: v != null) g.artwork)
      ) cfg.games
    );

    programs.steam.client.internal.settings =
      lib.optionals (cfg.defaultCompatTool != null) (compatEntries "0" cfg.defaultCompatTool "" 75)
      ++ lib.concatLists (
        lib.mapAttrsToList (
          appid: g:
          lib.optionals (g.compatTool != null) (compatEntries appid g.compatTool g.compatToolConfig 250)
          ++ lib.concatMap (
            p:
            lib.optional (g.${p.option} != null) {
              store = storeOf appid p.file;
              key = lib.replaceStrings [ "<appid>" "/" ] [ appid "\\" ] p.path;
              value = propValue p g.${p.option};
            }
          ) props
        ) cfg.games
      );
  };
}
